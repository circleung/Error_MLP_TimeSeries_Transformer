# --- OMC / session artifacts ---
.omc/

# --- data (large; lives in the source repo, referenced by absolute path) ---
*.csv
*.CSV

# --- checkpoints / weights ---
*.ckpt
*.pt

# --- training / eval outputs ---
logs/
cache/
*.cache
checkpoints/
lightning_logs/
training_logs/
*_logs*/
plots/
plots_*/

# --- notebooks scratch ---
.ipynb_checkpoints/

# --- python ---
__pycache__/
*.py[cod]

# --- archives ---
*.zip

# Project-local NVIDIA userspace compatibility libraries (not source)
.runtime/

# Journal pilot rollout dumps (regenerable, ~9MB each)
paper/journal/pilots/**/*.npz

# ======================================================================
# Repository scope: core model / ErrorMLP / scheduled-sampling code only.
# Papers, notes, figures, notebooks and analysis outputs stay local.
# ======================================================================
paper/
docs/
figures/
data/
scripts/
weights/
outputs/
release/
*.ipynb
*.pdf
*.npz
.runtime/
src/results/
src/custom_transformers/

# src/experiments: whitelist the core pipeline only
src/experiments/*
!src/experiments/__init__.py
!src/experiments/tail_analysis_acc.py
!src/experiments/train_error_mlp_acc.py
!src/experiments/eval_error_mlp_acc.py
